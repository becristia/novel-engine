{
  "name": "novel-engine",
  "version": "0.0.0",
  "private": true,
  "description": "单用户小说创作核心：可追溯的规划、写作、审稿与修订",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "novel": "tsx src/cli/main.ts",
